# ─────────────────────────────────────────────────────────────────────────────
# ABF Website — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your values from the Supabase dashboard (Settings > API)
#   3. Never commit your .env file to Git
#   4. For production, add these same variables in Netlify (Site > Environment Variables)
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL
# Found at: Supabase Dashboard > Settings > API > Project URL
# Example:  https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Your Supabase "anon public" key (also called the publishable key)
# Found at: Supabase Dashboard > Settings > API > Project API Keys > anon public
# This key is safe to use in the browser. It enforces Row Level Security.
# WARNING: Do NOT use the service_role key here. It bypasses all security.
VITE_SUPABASE_PUBLISHABLE_KEY=
